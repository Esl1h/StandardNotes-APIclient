{
  "name": "standardnotes-apiclient",
  "version": "0.5.2",
  "description": "HTTP API client editor for Standard Notes, using .http syntax",
  "keywords": [
    "Standard Notes",
    "Standard Notes Extensions",
    "Standard Notes Editors",
    "HTTP Client",
    "REST Client"
  ],
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esl1h/StandardNotes-APIclient.git"
  },
  "bugs": {
    "url": "https://github.com/Esl1h/StandardNotes-APIclient/issues"
  },
  "sn": {
    "main": "build/index.html"
  },
  "scripts": {
    "start": "vite --port 3001",
    "build": "vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "server": "vite preview --port 3000",
    "server-cors": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "pretty": "prettier --write 'src/**/*.{html,css,scss,js,jsx,ts,tsx,json}' README.md"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.5",
    "@standardnotes/editor-kit": "github:standardnotes/editor-kit#626d7a6e63d4ada48be36676c466fea46d7709d3",
    "@standardnotes/stylekit": "^5.29.3",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jsonwebtoken": "^9.0.2"
  }
}
